#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r8) uniform readonly image2D glyphImage;

layout(set = 0, binding = 1, r8) uniform writeonly image2D glyphMapSdfImage;

layout(set = 0, binding = 2) buffer Glyph {
	vec2 offset;
} glyph;

// Size of a glyph part in the map.
const uvec2 OUTPUT_IMAGE_SIZE = uvec2(64, 64);

void main() {
	uvec2 glyphMapSdfImageCoordinate = gl_GlobalInvocationID.xy;

	// Make sure that the coordinate is inside the glyph sub-image.
	if (glyphMapSdfImageCoordinate.x >= OUTPUT_IMAGE_SIZE.x || glyphMapSdfImageCoordinate.y >= OUTPUT_IMAGE_SIZE.y) {
		return;
	}

	//uvec2 inputTexelCoordinate = uvec2(glyphMapSdfImageCoordinate * OUTPUT_IMAGE_SIZE + OUTPUT_IMAGE_SIZE / 2);
	vec2 inputTexelCoordinate = glyphMapSdfImageCoordinate * OUTPUT_IMAGE_SIZE + OUTPUT_IMAGE_SIZE / 2;
	inputTexelCoordinate = min(inputTexelCoordinate, vec2(4096, 4096));

	vec4 inputTexel = imageLoad(glyphImage, ivec2(gl_GlobalInvocationID.xy * 64.0f));
	vec4 outputTexel = inputTexel;

	outputTexel.r += glyphMapSdfImageCoordinate.x / float(64.0);

	imageStore(glyphMapSdfImage, ivec2(glyphMapSdfImageCoordinate + glyph.offset), outputTexel);
}