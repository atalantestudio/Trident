#version 450

struct Edge {
	ivec2 start;
	ivec2 end;
	ivec2 control;
	bool curved;
};

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer readonly Font {
	uint spreadFactor;
	int ascent;
	int descent;
} font;

layout(set = 0, binding = 1) buffer readonly Glyph {
	Edge edges[];
} glyph;

layout(set = 0, binding = 2, r8) uniform writeonly image2D glyphImage;

// Size of the a glyph part in the map.
const uvec2 OUTPUT_IMAGE_SIZE = uvec2(64, 64);

void main() {
	uvec2 imageCoordinate = gl_GlobalInvocationID.xy;
	uvec2 glyphImageSize = imageSize(glyphImage);

	if (imageCoordinate.x >= glyphImageSize.x || imageCoordinate.y >= glyphImageSize.y) {
		return;
	}

	vec2 glyphCoordinate = imageCoordinate;

	// Add spread offset.
	glyphCoordinate.x -= OUTPUT_IMAGE_SIZE.x * font.spreadFactor;
	glyphCoordinate.y += OUTPUT_IMAGE_SIZE.y * font.spreadFactor;

	// Flip glyph Y coordinate.
	glyphCoordinate.y = glyphImageSize.y - glyphCoordinate.y;

	uint lineHeight = font.ascent - font.descent;

	glyphCoordinate /= glyphImageSize;
	glyphCoordinate *= lineHeight + OUTPUT_IMAGE_SIZE * font.spreadFactor;

	// Add font descent.
	glyphCoordinate.y += font.descent;

	vec4 texel = vec4(0.0, 0.0, 0.0, 1.0);
	vec2 p = glyphCoordinate;
	int windingNumber = 0;

	for (uint edgeIndex = 0; edgeIndex < glyph.edges.length(); edgeIndex += 1) {
		Edge edge = glyph.edges[edgeIndex];
		vec2 a = edge.start;
		vec2 b = edge.end;

		// Test if the current scanline crosses the edge.
		if (a.y > p.y && p.y > b.y) {
			// Top-to-bottom edge.
			float crossProduct = (a.x - p.x) * (b.y - p.y) - (b.x - p.x) * (a.y - p.y);

			if (crossProduct < 0.0) {
				windingNumber += 1;
			}
		}
		else if (b.y > p.y && p.y > a.y) {
			// Bottom-to-top edge.
			float crossProduct = (a.x - p.x) * (b.y - p.y) - (b.x - p.x) * (a.y - p.y);

			if (crossProduct > 0.0) {
				windingNumber -= 1;
			}
		}

		if (edge.curved) {
			vec2 c = edge.control;

			float u = ((a.y - b.y) * (p.x - b.x) + (b.x - a.x) * (p.y - b.y)) / ((a.y - b.y) * (c.x - b.x) + (b.x - a.x) * (c.y - b.y));
			float v = ((b.y - c.y) * (p.x - b.x) + (c.x - b.x) * (p.y - b.y)) / ((a.y - b.y) * (c.x - b.x) + (b.x - a.x) * (c.y - b.y));
			float w = 1.0 - u - v;

			// Test if the current texel is inside the triangle.
			//if (u >= 0.0f && u <= 1.0f && v >= 0.0f && v <= 1.0f && w >= 0.0f && w <= 1.0f) {
			if (0.0 < u && u < 1.0 && 0.0 < v && v < 1.0 && 0.0 < w && w < 1.0) {
				vec2 controlToStart = a - c;
				vec2 controlToEnd = b - c;
				float crossProduct = controlToStart.x * controlToEnd.y - controlToStart.y * controlToEnd.x;

				vec2 uw = vec2(0.5f, 0.0f) * u + vec2(0, 0) * v + vec2(1, 1) * w;
				float coordinate = uw.x * uw.x - uw.y;

				if (crossProduct < 0.0) {
					coordinate = uw.y - uw.x * uw.x;
				}

				if (coordinate <= 0.0) {
					windingNumber += 1;
				}
				else {
					windingNumber -= 1;
				}
			}
		}
	}

	texel.r = float(windingNumber > 0);

	imageStore(glyphImage, ivec2(imageCoordinate), texel);
}