#version 450

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, r8) uniform readonly image2D glyphImage;

layout(set = 0, binding = 1, r8) uniform writeonly image2D glyphMapSdfImage;

layout(set = 0, binding = 2) buffer readonly Font {
	uint outputGlyphSize;
} font;

layout(set = 0, binding = 3) buffer Glyph {
	uvec2 offset;
	uint spreadFactor;
} glyph;

void main() {
	// Size of the a glyph part in the map.
	uvec2 outputImageSize = uvec2(font.outputGlyphSize, font.outputGlyphSize);

	uvec2 glyphMapSdfImageCoordinate = gl_GlobalInvocationID.xy;

	// Make sure that the coordinate is inside the glyph sub-image.
	if (glyphMapSdfImageCoordinate.x >= outputImageSize.x || glyphMapSdfImageCoordinate.y >= outputImageSize.y) {
		return;
	}

	uvec2 glyphImageSize = imageSize(glyphImage);

	// TODO(review): Support custom output image size (multiply up).
	uvec2 inputTexelCoordinate = uvec2(glyphMapSdfImageCoordinate * outputImageSize + outputImageSize / 2);

	vec4 inputTexel = imageLoad(glyphImage, ivec2(inputTexelCoordinate));
	vec4 outputTexel = vec4(0.0, 0.0, 0.0, 1.0);

	const uint spread = outputImageSize.x * glyph.spreadFactor;

	uvec2 sampleStart = uvec2(
		max(0, int(inputTexelCoordinate.x) - int(spread)),
		max(0, int(inputTexelCoordinate.y) - int(spread))
	);

	uvec2 sampleEnd = uvec2(
		min(glyphImageSize.x - 1, inputTexelCoordinate.x + spread),
		min(glyphImageSize.y - 1, inputTexelCoordinate.y + spread)
	);

	uint closestSquareDistance = max(1, spread * spread);

	if (glyph.spreadFactor > 0) {
		for (uint y = sampleStart.y; y < sampleEnd.y; y += glyph.spreadFactor) {
			for (uint x = sampleStart.x; x < sampleEnd.x; x += glyph.spreadFactor) {
				uvec2 sampleCoordinate = uvec2(x, y);

				float r = imageLoad(glyphImage, ivec2(sampleCoordinate)).r;

				if (r == inputTexel.r) {
					continue;
				}

				uvec2 power = ivec2(pow(ivec2(inputTexelCoordinate - sampleCoordinate), uvec2(2, 2)));
				uint squareDistance = power.x + power.y;

				closestSquareDistance = min(closestSquareDistance, squareDistance);
			}
		}
	}

	float closestDistance = sqrt(closestSquareDistance);

	if (inputTexel.r != 1.0) {
		closestDistance *= -1.0;
	}

	outputTexel.r = (closestDistance / spread) * 0.5 + 0.5;

	imageStore(glyphMapSdfImage, ivec2(glyph.offset + glyphMapSdfImageCoordinate), outputTexel);
}