#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D image;

void main() {
	ivec2 imageCoordinate = ivec2(gl_GlobalInvocationID.xy);
	vec2 size = vec2(imageSize(image));

	vec4 color = vec4(gl_GlobalInvocationID.xy / size, 0.0, 1.0);

	imageStore(image, imageCoordinate, color);
}