#version 450

struct Edge {
	ivec2 start;
	ivec2 end;
	ivec2 control;
	bool quadraticCurve;
};

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer readonly Glyph {
	ivec2 minCoordinate;
	ivec2 maxCoordinate;
	Edge edges[];
} glyph;

layout(set = 0, binding = 1, r8) uniform writeonly image2D image;

void main() {
	vec2 _imageSize = imageSize(image);
	vec2 imageCoordinate = gl_GlobalInvocationID.xy;
	ivec2 glyphSquareSize = ivec2(max(glyph.maxCoordinate.x - glyph.minCoordinate.x, glyph.maxCoordinate.y - glyph.minCoordinate.y));

	vec2 p = (imageCoordinate + 1.0) / _imageSize * glyphSquareSize + abs(glyph.minCoordinate);

	// Flip glyph Y.
	p.y = glyphSquareSize.y - p.y;

	int windingNumber = 0;
	vec4 texel = vec4(0.0, 0.0, 0.0, 1.0);

	for (int edgeIndex = 0; edgeIndex < glyph.edges.length(); edgeIndex += 1) {
		vec2 a = vec2(glyph.edges[edgeIndex].start);
		vec2 b = vec2(glyph.edges[edgeIndex].end);

		// Test if the current scanline crosses the edge.
		if (a.y > p.y && p.y > b.y) {
			// Top-to-bottom edge.
			float direction = (a.x - p.x) * (b.y - p.y) - (b.x - p.x) * (a.y - p.y);

			if (direction < 0.0) {
				windingNumber += 1;
			}
		}
		else if (b.y > p.y && p.y > a.y) {
			// Bottom-to-top edge.
			float direction = (a.x - p.x) * (b.y - p.y) - (b.x - p.x) * (a.y - p.y);

			if (direction > 0.0) {
				windingNumber -= 1;
			}
		}
	}

	texel.r = float(windingNumber > 0);

	imageStore(image, ivec2(imageCoordinate), texel);
}