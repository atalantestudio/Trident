#version 450

struct Edge {
	ivec2 start;
	ivec2 end;
	ivec2 control;
	bool isQuadraticCurve;
};

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(std140, set = 0, binding = 0) buffer readonly Glyph {
	ivec2 minCoordinate;
	ivec2 maxCoordinate;
	Edge edges[];
};
layout(set = 0, binding = 1, r8) uniform writeonly image2D image;

void main() {
	vec2 imageCoordinate = vec2(gl_GlobalInvocationID.xy);
	ivec2 glyphSize = ivec2(max(maxCoordinate.x - minCoordinate.x, maxCoordinate.y - minCoordinate.y));
	vec2 glyphCoordinate = (imageCoordinate + 1.0) / vec2(imageSize(image)) * vec2(glyphSize);
	glyphCoordinate.y = glyphSize.y - glyphCoordinate.y;

	vec4 color = vec4(0.0, 0.0, 0.0, 1.0);
	int windingOrder = 0;

	for (int edgeIndex = 0; edgeIndex < edges.length(); edgeIndex += 1) {
		Edge edge = edges[edgeIndex];
		vec2 start = vec2(edge.start);
		vec2 end = vec2(edge.end);

		// The crossed edge goes from top to bottom.
		if (start.y > glyphCoordinate.y && glyphCoordinate.y > end.y) {
			float direction =
				(start.x - glyphCoordinate.x)
				*
				(end.y - glyphCoordinate.y)
				-
				(end.x - glyphCoordinate.x)
				*
				(start.y - glyphCoordinate.y);

			if (direction < 0.0) {
				// On left.
				windingOrder += 1;
			}
		}

		// The crossed edge goes from bottom to top.
		else if (end.y > glyphCoordinate.y && glyphCoordinate.y > start.y) {
			float direction =
				(start.x - glyphCoordinate.x)
				*
				(end.y - glyphCoordinate.y)
				-
				(end.x - glyphCoordinate.x)
				*
				(start.y - glyphCoordinate.y);

			if (direction > 0.0) {
				// On right.
				windingOrder -= 1;
			}
		}
	}

	color.r = float(windingOrder > 0);

	imageStore(image, ivec2(imageCoordinate), color);
}