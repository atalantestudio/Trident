#version 450

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(binding = 0, rgba8) uniform writeonly image2D image;

void main() {
	vec2 imageCoordinate = gl_GlobalInvocationID.xy;

	// TODO: Fix imageSize returning (0, 0) on Intel UHD Graphics 4.6.0 (HP Victus laptop).
	// TODO: Try removing writeonly attribute.
	vec4 color = vec4(imageCoordinate / vec2(imageSize(image)), 0.0, 1.0);

	imageStore(image, ivec2(imageCoordinate), color);
}