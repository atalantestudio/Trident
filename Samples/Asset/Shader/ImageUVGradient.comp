#version 450

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform image2D image;

void main() {
	vec2 imageCoordinate = gl_GlobalInvocationID.xy;
	vec2 size = vec2(imageSize(image));

	// TODO: Fix imageSize returning (0, 0) on Intel UHD Graphics 4.6.0 (HP Victus laptop).
	vec4 color = vec4(imageCoordinate / size, 0.0, 1.0);

	imageStore(image, ivec2(imageCoordinate), color);
}