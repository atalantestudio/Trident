{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run AssetBuilder",
			"type": "cppvsdbg",
			"request": "launch",
			"program": "${workspaceFolder}/bin/windows_x86_64_${command:cpptools.activeConfigName}/AssetBuilder/AssetBuilder.exe",
			"args": [
				"${workspaceFolder}/Samples",
				"${workspaceFolder}/bin/windows_x86_64_${command:cpptools.activeConfigName}/Samples",
			],
			"cwd": "${workspaceFolder}/AssetBuilder",
			"console": "integratedTerminal"
		},
		{
			"name": "Run Samples",
			"type": "cppvsdbg",
			"request": "launch",
			"program": "${workspaceFolder}/bin/windows_x86_64_${command:cpptools.activeConfigName}/Samples/Samples.exe",
			"cwd": "${workspaceFolder}/bin/windows_x86_64_${command:cpptools.activeConfigName}/Samples",
			"console": "integratedTerminal"
		},
		{
			"name": "Run TSL LSP Server",
			"type": "cppvsdbg",
			"request": "launch",
			"program": "${workspaceFolder}/bin/windows_x86_64_${command:cpptools.activeConfigName}/tsllsp/tsllsp.exe",
			"cwd": "${workspaceFolder}/Trident/vendor/tsl",
			"console": "integratedTerminal"
		}
	]
}