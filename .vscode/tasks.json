{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build (Debug)",
			"type": "process",
			"command": "MSBuild.exe",
			"args": [
				"ProjectA.sln",
				"/property:Configuration=Debug"
			],
			"group": {
				"kind": "build"
			},
			"presentation": {
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build (Profile)",
			"type": "process",
			"command": "MSBuild.exe",
			"args": [
				"ProjectA.sln",
				"/property:Configuration=Profile"
			],
			"group": {
				"kind": "build"
			},
			"presentation": {
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build (Release)",
			"type": "process",
			"command": "MSBuild.exe",
			"args": [
				"ProjectA.sln",
				"/property:Configuration=Release"
			],
			"group": {
				"kind": "build"
			},
			"presentation": {
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Clean",
			"type": "shell",
			"command": "rm -rf bin/* && rm -rf obj/*",
			"group": {
				"kind": "build"
			},
			"presentation": {
				"clear": true
			}
		}
	]
}