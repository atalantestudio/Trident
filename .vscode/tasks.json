{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Generate Windows Project Files (Visual Studio 2022)",
			"type": "process",
			"command": "scripts/Windows/premake5_vs2022.bat",
			"group": {
				"kind": "build"
			},
			"presentation": {
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build (Debug)",
			"type": "process",
			"command": "MSBuild.exe",
			"args": [
				"ProjectA.sln",
				"/t:Build",
				"/property:Configuration=Debug"
			],
			"group": {
				"kind": "build"
			},
			"presentation": {
				"group": "Build",
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build (Profile)",
			"type": "process",
			"command": "MSBuild.exe",
			"args": [
				"ProjectA.sln",
				"/t:Build",
				"/property:Configuration=Profile"
			],
			"group": {
				"kind": "build"
			},
			"presentation": {
				"group": "Build",
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build (Release)",
			"type": "process",
			"command": "MSBuild.exe",
			"args": [
				"ProjectA.sln",
				"/t:Build",
				"/property:Configuration=Release"
			],
			"group": {
				"kind": "build"
			},
			"presentation": {
				"group": "Build",
				"clear": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Clean",
			"type": "shell",
			"command": "rm -rf .vs && rm -rf bin && rm -rf obj",
			"group": {
				"kind": "build"
			},
			"presentation": {
				"clear": true
			}
		}
	]
}